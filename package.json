{
  "name": "govuk-frontend-example-typescript",
  "version": "0.0.0",
  "private": true,
  "description": "TypeScript line of the GDS-compliant GOV.UK Frontend template. Server-rendered HTML via Node/TypeScript + Nunjucks; no SPA UI frameworks.",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint:md": "markdownlint-cli2",
    "verify:docs": "npm run format:check && npm run lint:md",
    "typecheck": "tsc --noEmit",
    "start": "tsx src/main.ts",
    "test": "c8 --all --src src --include 'src/**/*.ts' --exclude 'src/**/*.test.ts' --exclude 'src/main.ts' --reporter=text --check-coverage --lines 100 --statements 100 --branches 100 --functions 100 -- node --import tsx --test 'src/**/*.test.ts'",
    "verify": "npm run verify:docs && npm run typecheck && npm test",
    "sync:template": "./scripts/sync-from-template.sh"
  },
  "devDependencies": {
    "@types/node": "24.5.2",
    "@types/nunjucks": "3.2.6",
    "c8": "12.0.0",
    "markdownlint-cli2": "0.23.3",
    "prettier": "3.6.2",
    "tsx": "4.20.5",
    "typescript": "7.0.2"
  },
  "dependencies": {
    "govuk-frontend": "6.5.1",
    "nunjucks": "3.2.4"
  }
}
