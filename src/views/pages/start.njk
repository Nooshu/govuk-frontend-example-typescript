{% extends "layout.njk" %}
{% from "macros/columns.njk" import twoThirds %}
{% from "govuk/components/notification-banner/macro.njk" import govukNotificationBanner %}
{% from "govuk/components/button/macro.njk" import govukButton %}
{% from "govuk/components/warning-text/macro.njk" import govukWarningText %}
{% from "govuk/components/inset-text/macro.njk" import govukInsetText %}
{% from "govuk/components/details/macro.njk" import govukDetails %}

{% block content %}
  {% call twoThirds() %}
    {{ govukNotificationBanner(notification) }}
    <h1 class="govuk-heading-xl">{{ heading }}</h1>
    <p class="govuk-body-l">{{ lede }}</p>
    {{ govukButton(startButton) }}
    <p class="govuk-body">{{ timing }}</p>
    {{ govukWarningText(warning) }}
    {{ govukInsetText(inset) }}
    {{ govukDetails(details) }}
    {% if demosEnabled %}
      <h2 class="govuk-heading-m">
        {%- if htmlLang == "cy" %}Rhagolygon datblygwyr{% else %}Developer previews{% endif -%}
      </h2>
      <p class="govuk-body">
        {% if htmlLang == "cy" %}
          <a class="govuk-link" href="/components">Rhagolwg o gydrannau GOV.UK</a> — tudalen ar wahân ar gyfer pob cydran, wedi’i rendro gan y llyfrgell TypeScript.
        {% else %}
          <a class="govuk-link" href="/components">Preview GOV.UK components</a> — a separate page for each component, rendered by this service’s TypeScript library.
        {% endif %}
      </p>
    {% endif %}
  {% endcall %}
{% endblock %}
